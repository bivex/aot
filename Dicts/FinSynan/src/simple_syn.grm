%% ========== Finnish Syntax Rules ==========

[NOUN] -> [TOKEN grm="NOUN"];
[ADJ] -> [TOKEN grm="ADJ"];
[VERB] -> [TOKEN grm="VERB"];
[ADV] -> [TOKEN grm="ADV"];
[PRON] -> [TOKEN grm="PRON"];
[CONJ] -> [TOKEN grm="CONJ"];
[NUM] -> [TOKEN grm="NUM"];
[PART] -> [TOKEN grm="PART"];
[ADP] -> [TOKEN grm="ADP"];
[PROPN] -> [TOKEN grm="PROPN"];

[NP] -> [NOUN];
[NP] -> [PRON];
[NP] -> [ADJ] [NOUN];
[NP] -> [NUM] [NOUN];
[NP] -> [ADJ] [NOUN root];
[NP] -> [NOUN root] [ADP] [NOUN];
[NP] -> [PROPN];

[VP] -> [VERB root];
[VP] -> [VERB root] [NP];
[VP] -> [VERB root] [ADV];
[VP] -> [ADV] [VERB root];
[VP] -> [NP] [VERB root];
[VP] -> [VERB root] [NP] [ADP] [NP];
[VP] -> [VERB root] [PART] [VERB];

[PP] -> [ADP] [NP];

[SP] -> [NP] [VP];
[SP] -> [NP] [VP] [NP];
[SP] -> [NP] [VP] [PP];
[SP] -> [NP] [VP] [ADV];
[SP] -> [SP] [CONJ] [SP];

[SYN_GROUP] -> [NP] | [VP] | [SP] | [PP] | [PART] | [ADV];
