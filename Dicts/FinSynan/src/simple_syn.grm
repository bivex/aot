%% ========== Finnish Syntax Rules ==========
%% Single root: SYN_GROUP

%% ========== Atomic categories ==========

[NOUN] -> [TOKEN grm="NOUN"];
[ADJ] -> [TOKEN grm="ADJ"];
[VERB] -> [TOKEN grm="VERB"];
[ADV] -> [TOKEN grm="ADV"];
[PRON] -> [TOKEN grm="PRON"];
[ADP] -> [TOKEN grm="ADP"];
[CONJ] -> [TOKEN grm="CONJ"];
[NUM] -> [TOKEN grm="NUM"];
[PART] -> [TOKEN grm="PART"];

%% ========== Adjective Phrase (AP) ==========

[AP] -> [ADJ];
[AP] -> [ADV] [AP root];

%% ========== Noun Phrase (NP) ==========
%% Finnish: no articles, adjectives before nouns

[NP] -> [NOUN];
[NP] -> [PRON];
[NP] -> [ADJ] [NOUN];
[NP] -> [ADJ] [ADJ] [NOUN];
[NP] -> [NOUN] [ADJ];
[NP] -> [NUM] [NOUN];
[NP] -> [ADJ] [NUM] [NOUN];

%% NP with postpositional attachment
[NP] -> [NP] [PP];

%% ========== Postpositional/Prepositional Phrase (PP) ==========
%% Finnish uses both postpositions and some prepositions

[PP] -> [NP] [ADP];
[PP] -> [ADP] [NP];

%% Common Finnish postpositions (accent-stripped)
[PP-KANSSA] -> [NP] 'KANSSA';
[PP-ILMAN] -> [NP] 'ILMAN';
[PP-JALKEEN] -> [NP] 'JALKEEN';
[PP-ALLA] -> [NP] 'ALLA';
[PP-YLLA] -> [NP] 'YLLA';
[PP-PAALLE] -> [NP] 'PAALLE';
[PP-EDALLA] -> [NP] 'EDALLA';
[PP-JALKEEN] -> [NP] 'JLKEEN';

%% ========== Verb Phrase (VP) ==========

[VP] -> [VERB root];
[VP] -> [ADV] [VERB root];

%% VP extensions
[VP] -> [VP] [PP];
[VP] -> [VP] [NP];
[VP] -> [VP] [ADV];
[VP] -> [ADV] [VP];
[VP] -> [NP] [VP];

%% ========== Coordination ==========

[NP] -> [NP] [CONJ] [NP];
[NP] -> [NP] ',' [CONJ] [NP];
[VP] -> [VP] [CONJ] [VP];
[VP] -> [VP] ',' [CONJ] [VP];
[PP] -> [PP] [CONJ] [PP];

%% ========== Subject-Predicate (SP) ==========
%% Finnish: flexible word order (SVO, OVS, VSO all possible)

[SP] -> [NP] [VP];
[SP] -> [NP] [VP] [PP];
[SP] -> [NP] [VP] [NP];
[SP] -> [NP] [VP] [PP] [PP];
[SP] -> [NP] [VP] [NP] [PP];
[SP] -> [NP] [VP] [ADJ];
[SP] -> [VP] [NP];
[SP] -> [VP] [NP] [PP];
[SP] -> [SP] [PP];
[SP] -> [SP] [CONJ] [SP];

%% ========== Root ==========
[SYN_GROUP] -> [NP] | [VP] | [PP] | [SP] | [AP] | [PART];
